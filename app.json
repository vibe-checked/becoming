{
  "expo": {
    "name": "Becoming",
    "slug": "becoming",
    "version": "1.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.markutilitylabs.becoming",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Becoming uses the microphone to record your own affirmations.",
        "NSPhotoLibraryUsageDescription": "Becoming lets you add personal photos to play during sessions.",
        "NSSpeechRecognitionUsageDescription": "Becoming uses speech recognition for voice recording."
      },
      "appleTeamId": "XJ2F96322L"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a12",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.markutilitylabs.becoming"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": "Becoming uses the microphone to record your own affirmations."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Becoming lets you add personal photos to play during sessions."
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "StreakWidget",
              "displayName": "Streak & Affirmation",
              "description": "Shows your current streak and today's affirmation.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a12",
          "imageWidth": 250,
          "dark": {
            "backgroundColor": "#0a0a12"
          }
        }
      ]
    ]
  }
}